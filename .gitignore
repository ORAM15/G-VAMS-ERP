# dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# environment variables
.env

# build files
frontend/build/

# misc
.DS_Store
npm-debug.log
# autonomous runtime ephemeral logs and prompts
.agent/runtime/*-openhands.jsonl
.agent/runtime/*-task.txt
.agent/runtime/planned-validation.json
.agent/runtime/validation-results.json
.agent/runtime/pr-body.md

# Repository Intelligence v1 generated output (timestamped on every run; regenerate with
# `node scripts/repository-intelligence.js`)
/repository-intelligence/

# Engineering Knowledge Engine v1 generated output (timestamped on every run; regenerate with
# `node scripts/engineering-knowledge.js`)
/engineering-knowledge/

# Recommendation Engine v1 generated output (timestamped on every run; regenerate with
# `node scripts/recommendation-engine.js`)
/recommendations/

# Autonomous Engineer Dashboard's synced copy of the three generated JSON files above (see
# frontend/scripts/sync-autonomous-data.js); regenerated automatically by `npm start` / `npm run build`
frontend/public/autonomous-engineer-data/

# Decision Engine v1 generated output (timestamped on every run; regenerate with
# `node scripts/decision-engine.js`)
/decision/

# Implementation Request Engine v1 generated output (timestamped on every run; regenerate with
# `node scripts/implementation-request-engine.js`)
/implementation-request/

# Implementation Executor v1 generated output (timestamped on every run; regenerate with
# `node scripts/implementation-executor.js`)
/execution/
